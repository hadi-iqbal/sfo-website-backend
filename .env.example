APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=sfo
DB_USERNAME=root
DB_PASSWORD=

FRONTEND_URL=http://localhost:3000
ADMIN_EMAIL=admin@securityfinancialonline.com
ADMIN_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Nirvana integrations. Leave provider credentials empty until staging is configured.
NIRVANA_OPENAI_KEY=
NIRVANA_MODEL=gpt-6-luna
NIRVANA_KNOWLEDGE_STORE=
# NIRVANA_WEBSITE_PDF= (optional absolute path; defaults to output/pdf/sfo-public-website-knowledge-2026-11.pdf)
NIRVANA_RATE_VERSION=legacy-2026-04
NIRVANA_ZOOM_ACCOUNT=
NIRVANA_ZOOM_CLIENT=
NIRVANA_ZOOM_SECRET=
NIRVANA_ZOOM_HOST=
NIRVANA_ZOOM_WEBHOOK_SECRET=
NIRVANA_SEND_INVITES=false
NIRVANA_BOOKING_TIMEZONE=America/New_York
NIRVANA_BOOKING_HOURS=9,10,13,14,15,16
NIRVANA_STAFF_EMAILS="NirvanaAI@securityfinancialonline.com,marlon@securityfinancialonline.com"
NIRVANA_EMAIL_TRANSPORT=graph
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_SENDER_EMAIL=
NIRVANA_END_GRACE_SECONDS=90
NIRVANA_STALE_MINUTES=30

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
